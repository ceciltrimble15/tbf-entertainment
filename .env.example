# TBF Entertainment — environment variables
#
# Copy this file to `.env.local` (which is git-ignored) for local dev, and set
# the same variables in your Vercel Project → Settings → Environment Variables
# for production. NEVER commit real secrets to the repository.

# Form delivery endpoint for the contact / lead-capture forms.
# Create a form at https://formspree.io (or another approved backend) using
# info@tbfentertainment.art and paste its endpoint here, e.g.
#   VITE_FORM_ENDPOINT=https://formspree.io/f/abcdwxyz
# When empty/unset, forms fall back to opening the visitor's email client
# (mailto) so no lead is silently lost. See docs/FORM_SETUP.md.
VITE_FORM_ENDPOINT=
